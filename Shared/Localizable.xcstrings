{
  "sourceLanguage": "en",
  "strings": {
    "R01.allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If needed, test a maker-approved water-based upholstery cleaner on a hidden spot. After it dries unchanged, follow the label for limited spot use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需去渍，先在隐蔽处测试厂商允许的水性软包清洁剂。小样干透且无异常后，按标签少量局部使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需去漬，先在隱蔽處測試廠商允許的水性軟包清潔劑。小樣乾透且無異常後，按標籤少量局部使用。"
          }
        }
      }
    },
    "R01.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fabric Upholstered Furniture; B Code W; C §§2–3; D §7"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A「Fabric Upholstered Furniture」、B「Code W」、C §2–3、D §7"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A「Fabric Upholstered Furniture」、B「Code W」、C §2–3、D §7"
          }
        }
      }
    },
    "R01.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently blot fresh surface liquid with a clean, dry white cloth. Avoid rubbing. If spot cleaning is needed, test a maker-approved water-based upholstery cleaner on a hidden area, then follow the label for limited spot use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新鲜表面液体先用干净干白布轻按吸走，勿揉。需去渍时，先隐蔽处测试厂商明确允许的水性软包清洁剂，按标签少量局部使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮表面液體先用乾淨乾白布輕按吸走，勿揉。需去漬時，先在隱蔽處測試廠商明確允許的水性軟包清潔劑，按標籤少量局部使用。"
          }
        }
      }
    },
    "R01.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the test area dry fully. Check for color transfer, changes in shape or a ring. Recheck the treated area once dry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小样干透后看是否掉色、变形、起圈；处理处也在干透后复查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小樣乾透後看是否掉色、變形、起圈；處理處也在乾透後複查。"
          }
        }
      }
    },
    "R01.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if color or texture changes, a ring or residue remains, or liquid reaches the inner cushion. Ask the maker or an upholstery cleaner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "掉色、纹理变化、起圈、残留或渗进内层时停止；找厂商或软包清洁人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掉色、紋理變化、起圈、殘留或滲進內層時停止；找廠商或軟包清潔人員。"
          }
        }
      }
    },
    "R02.allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the maker permits water-based care, test a hidden spot first and let it dry. Follow the model’s instructions if it dries unchanged. Leave solvent work to a professional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在原厂允许水性护理时先试隐蔽处。小样干透且无异常后，按该型号的说明处理。无水处理交专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在原廠允許水性護理時先試隱蔽處。小樣乾透且無異常後，按該型號的說明處理。無水處理交專業人員。"
          }
        }
      }
    },
    "R02.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A WS/SW; B Code W-S; C §§2–3; E"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A「WS/SW」、B「Code W-S」、C §2–3、E"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A「WS/SW」、B「Code W-S」、C §2–3、E"
          }
        }
      }
    },
    "R02.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow R01 only when the maker allows water-based care. Have an upholstery professional handle any solvent-based cleaning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同 R01，仅在厂商说明允许时走水性分支；有溶剂适用需求的情况交专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同 R01，僅在廠商說明允許時走水性分支；有溶劑適用需求的情況交專業人員。"
          }
        }
      }
    },
    "R02.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow R01. Test a hidden area according to the model’s care instructions and let it dry fully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同 R01，按实际护理说明验小样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同 R01，按實際護理說明驗小樣。"
          }
        }
      }
    },
    "R02.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if the maker restricts water-based care for the model or if obvious residue remains after the first pass. Avoid trying another product over it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水性护理受型号限制、或首轮仍有明显残留时停止，不换另一类产品叠试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水性護理受型號限制、或首輪仍有明顯殘留時停止，不換另一類產品疊試。"
          }
        }
      }
    },
    "R03.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A S; B Code S; C §§2–3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A「S」、B「Code S」、C §2–3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A「S」、B「Code S」、C §2–3"
          }
        }
      }
    },
    "R03.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently blot fresh surface liquid with a dry white cloth. Ask an upholstery professional to handle any further stain removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新鲜表面液体用干白布轻按吸走；将进一步去渍交给专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮表面液體用乾白布輕按吸走；將進一步去漬交給專業人員。"
          }
        }
      }
    },
    "R03.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After it dries, check for residue or a ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看干燥后是否残留或出现水圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看乾燥後是否殘留或出現水圈。"
          }
        }
      }
    },
    "R03.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep water off the fabric. S is the maker’s code for water-free care. Leave the method to a professional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不加水。App 只说明 S 代表厂商的无水方法范围，具体处理交专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不加水。App 只說明 S 代表廠商的無水方法範圍，具體處理交專業人員。"
          }
        }
      }
    },
    "R04.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A X; B Code X"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A「X」、B「Code X」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A「X」、B「Code X」"
          }
        }
      }
    },
    "R04.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop applying liquid. For routine dry dust, follow the maker’s instructions for vacuuming or gentle brushing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止现场液体处理。日常干尘按厂商说明吸尘或轻刷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止現場液體處理。日常乾塵按廠商說明吸塵或輕刷。"
          }
        }
      }
    },
    "R04.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for an existing wet spot or old mark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查是否已有湿渍或旧印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查是否已有濕漬或舊印。"
          }
        }
      }
    },
    "R04.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take wet spots or persistent marks to an upholstery professional. Keep cleaning liquids off the fabric and avoid other home cleaning steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "湿渍或持续留印交专业人员；不推荐清洁液或在家试剂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "濕漬或持續留印交專業人員；不推薦清潔液或在家試劑。"
          }
        }
      }
    },
    "R05.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B Upholstery; C §§2–3; F Where do I find…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Upholstery」、C §2–3、F「Where do I find…」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Upholstery」、C §2–3、F「Where do I find…」"
          }
        }
      }
    },
    "R05.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause and find the model or care tag. For fresh liquid sitting on fabric, gently blot with a dry white cloth. Wait for the maker’s permission before applying liquid or cleaner. If approved, test a hidden spot first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先停手查型号或护理标。若只是新鲜织物表面液体，可用干白布轻按吸去浮液。找不到许可时停止加液或清洁剂；取得许可后，第一道去渍操作是隐蔽处测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先停手查型號或護理標。若只是新鮮織物表面液體，可用乾白布輕按吸去浮液。找不到許可時停止加液或清潔劑；取得許可後，第一道去漬操作是隱蔽處測試。"
          }
        }
      }
    },
    "R05.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only the maker’s approved method on the test spot. When it dries fully, check for color transfer, changes in shape or a ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按厂商允许的方法做小样，干透后查掉色、变形、水圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅按廠商允許的方法做小樣，乾透後查掉色、變形、水圈。"
          }
        }
      }
    },
    "R05.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and contact the maker or a professional if permission is unclear, the instructions conflict, or the test spot changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可仍不明确、标签冲突或小样异常就停手，联系厂商或专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "許可仍不明確、標籤衝突或小樣異常就停手，聯絡廠商或專業人員。"
          }
        }
      }
    },
    "R06.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Leather Upholstered Furniture; B Leather Care; G"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A「Leather Upholstered Furniture」、B「Leather Care」、G"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A「Leather Upholstered Furniture」、B「Leather Care」、G"
          }
        }
      }
    },
    "R06.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the original instructions for the model. Test a hidden spot only as the maker explicitly permits. Fabric care codes do not apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查该型号的原厂护理说明，只有厂家明确许可后才按其说明先做隐蔽处测试。布艺标签通用步骤不适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查該型號的原廠護理說明，只有廠家明確許可後才按其說明先做隱蔽處測試。布藝標籤通用步驟不適用。"
          }
        }
      }
    },
    "R06.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the test spot dry. Check for changes in color, surface texture or coating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等小样干透，查颜色、表面纹理或涂层变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等小樣乾透，查顏色、表面紋理或塗層變化。"
          }
        }
      }
    },
    "R06.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and contact the maker or a specialist if instructions are unavailable, or if you notice browning, odor or seepage into seams."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查不到适用说明、已褐变、出现异味或渗入接缝时停止，联系厂商或对应材质的专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查不到適用說明、已褐變、出現異味或滲入接縫時停止，聯絡廠商或對應材質的專業人員。"
          }
        }
      }
    },
    "R07.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B Code W and Code W-S; C §2; D §7; H Coffee"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Code W」「Code W-S」、C §2、D §7、H「Coffee」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Code W」「Code W-S」、C §2、D §7、H「Coffee」"
          }
        }
      }
    },
    "R07.dry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the test spot and any treated area dry fully. Check for residue, a ring, color transfer or changes in shape or texture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等小样和处理处完全干透后，检查是否有残留、水圈、掉色、变形或纹理变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等小樣和處理處完全乾透後，檢查是否有殘留、水圈、掉色、變形或紋理變化。"
          }
        }
      }
    },
    "R07.escalate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause if the area is large, a ring has formed, or products were already applied. Seek help for odor or seepage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面积较大、起圈或已用过产品时停手；出现异味或渗入时找专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面積較大、起圈或已用過產品時停手；出現異味或滲入時找專業人員。"
          }
        }
      }
    },
    "R07.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For W or WS and a fresh spot confined to the surface, blot inward from the edge with a dry white cloth, then follow R01 or R02. This first step also covers milk-based coffee or tea. For odor or seepage, use R09."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "W / WS 且明确是局部表面时，干白布从污渍边缘向内按吸；后续遵循 R01/R02。选项「Coffee / tea」包括含奶饮料的首步；气味或渗入按 R09。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "W / WS 且明確是局部表面時，乾白布從污漬邊緣向內按吸；後續遵循 R01/R02。選項「Coffee / tea」包括含奶飲料的首步；氣味或滲入按 R09。"
          }
        }
      }
    },
    "R07.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After drying, look for residue or a ring. Stop at this card if residue remains."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "干透后看残留、水圈，已有残留时停在当前卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "乾透後看殘留、水圈，已有殘留時停在目前卡片。"
          }
        }
      }
    },
    "R07.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow R03–R05 for S, X or unknown tags. Use R10 for a large area, a ring or previously applied products."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "S / X / 未知服从 R03–R05。大面积、已叠用产品或已经起圈，转 R10。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "S / X / 不明服從 R03–R05。大面積、已疊用產品或已經起圈，轉 R10。"
          }
        }
      }
    },
    "R07.surface": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blot fresh surface liquid with a dry white cloth, from the edge inward. Avoid rubbing or soaking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新鲜浮液用干白布从边缘向内轻按吸走。勿揉或浸湿布面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮浮液用乾白布從邊緣向內輕按吸走。勿揉或浸濕布面。"
          }
        }
      }
    },
    "R08.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B care-code restrictions; C §§2–3; D §7; H stain chart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "B 各标签限制、C §2–3、D §7、H 污渍表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "B 各標籤限制、C §2–3、D §7、H 污漬表"
          }
        }
      }
    },
    "R08.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the tag allows contact, gently lift solids from a small, fresh food spill. Blot surface liquid according to R01–R03 or R05. For oily pigment, curry, ink or an unknown stain, limit care to those first steps or stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对确认可接触的局部新鲜食物，按标签许可轻提表面固体；仍有浮液时按 R01–R03/R05 对应的干吸规则。油性色素、咖喱、墨渍或无法辨识时只显示这种初步动作或停手，不提供配方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對確認可接觸的局部新鮮食物，按標籤許可輕提表面固體；仍有浮液時按 R01–R03/R05 對應的乾吸規則。油性色素、咖哩、墨漬或無法辨識時只顯示這種初步動作或停手，不提供配方。"
          }
        }
      }
    },
    "R08.food": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For fresh food in a small spot, gently lift surface solids if the label allows it. Blot loose liquid with a dry white cloth. Stop before adding products for curry or oily pigments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局部新鲜食物渍，在标签允许时轻提表面固体；浮液用干白布按吸。咖喱或油性色素渍先停手，勿追加产品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "局部新鮮食物漬，在標籤允許時輕提表面固體；浮液用乾白布按吸。咖哩或油性色素漬先停手，勿追加產品。"
          }
        }
      }
    },
    "R08.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether the stain has spread, transferred color or left residue after drying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看是否已扩大、转移颜色或干后仍残留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看是否已擴大、轉移顏色或乾後仍殘留。"
          }
        }
      }
    },
    "R08.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop adding products and ask a professional if any of these signs are present, the fabric is valuable or delicate, or the cause is unknown. Follow R04 or R06 for X or special materials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有此迹象、珍贵或娇贵面料、来源不明时停止追加产品，请专业人员判断。X 及特殊材质服从 R04/R06。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有此跡象、珍貴或嬌貴布料、來源不明時停止追加產品，請專業人員判斷。X 及特殊材質服從 R04/R06。"
          }
        }
      }
    },
    "R08.uncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause before adding products for ink, color transfer, or an unidentified stain. Ask an upholstery professional to assess it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨渍、掉色或不明污渍先停手，勿追加产品，请软包清洁人员判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "墨漬、掉色或不明污漬先停手，勿追加產品，請軟包清潔人員判斷。"
          }
        }
      }
    },
    "R09.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "C §5; I"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "C §5、I"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "C §5、I"
          }
        }
      }
    },
    "R09.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop adding liquid or trying to cover the odor. Contact an upholstery and odor specialist if you notice a urine smell, damp padding or contamination of unknown extent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止加液或用产品盖味。发现尿味、内垫受潮或污染范围无法确认时，直接联系软包和气味处理专业人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止加液或用產品蓋味。發現尿味、內墊受潮或污染範圍無法確認時，直接聯絡軟包和氣味處理專業人員。"
          }
        }
      }
    },
    "R09.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for odor after drying, damp padding or a stain that reappears."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查干后仍有异味、内垫仍湿或污渍反复出现等信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查乾後仍有異味、內墊仍濕或污漬反覆出現等訊號。"
          }
        }
      }
    },
    "R09.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a professional as soon as you suspect the spill reached the filling. Leave disinfection and deep cleaning to them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦疑似进入填充物就转专业；不提供消毒、除菌或深层处置步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦疑似進入填充物就轉專業；不提供消毒、除菌或深層處置步驟。"
          }
        }
      }
    },
    "R10.citation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B Upholstery; C §§1–3; D §7; E"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Upholstery」、C §1–3、D §7、E"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "B「Upholstery」、C §1–3、D §7、E"
          }
        }
      }
    },
    "R10.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop further cleaning. Note which products were used and record the original care tag for the maker or an upholstery professional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止继续处理，记录已用产品及原厂标签，供厂商或专业人员判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止繼續處理，記錄已用產品及原廠標籤，供廠商或專業人員判斷。"
          }
        }
      }
    },
    "R10.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for spreading, color changes, distortion or a returning mark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察是否扩大、掉色、变形或再出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察是否擴大、掉色、變形或再出現。"
          }
        }
      }
    },
    "R10.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a professional for help with set-in stains, clear rings or browning, possible mold, a large soaked area, combined products or an unusual odor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陈渍、明显水圈或褐变、疑似霉斑、大面积湿透、混用产品或异常气味直接显示转专业。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "陳漬、明顯水圈或褐變、疑似霉斑、大面積濕透、混用產品或異常氣味直接轉交專業人員。"
          }
        }
      }
    },
